                                        "text": "var st = thisComp.layer(\"Controls\").effect(\"Style\")(\"Menu\"); var n = textTotal, i = textIndex - 1; var t0 = thisComp.layer(\"Controls\").effect(\"Start\")(\"Slider\"); var d = thisComp.layer(\"Controls\").effect(\"Duration\")(\"Slider\"); var k = 1 + thisComp.layer(\"Controls\").effect(\"Ease\")(\"Slider\") / 25; var mv = st == 6 ? 0.6 * 1.6 : 0.6; var sg = st == 6 ? 0 : Math.min(thisComp.layer(\"Controls\").effect(\"Stagger\")(\"Slider\"), Math.max((d / 3 - mv) / Math.max(n - 1, 1), 0)); var p = Math.min(Math.max((time - t0 - i * sg) / mv, 0), 1); var t1 = d - 0.1 - mv - (n - 1) * sg; var q = Math.min(Math.max((time - t1 - i * sg) / mv, 0), 1); function back(x) { var c = 1.7; return 1 + (c + 1) * Math.pow(x - 1, 3) + c * Math.pow(x - 1, 2); } function bounce(x) { var a = 7.5625, b = 2.75; if (x < 1 / b) return a * x * x; if (x < 2 / b) { x -= 1.5 / b; return a * x * x + 0.75; } if (x < 2.5 / b) { x -= 2.25 / b; return a * x * x + 0.9375; } x -= 2.625 / b; return a * x * x + 0.984375; } var e = st == 3 || st == 7 ? back(p) : st == 8 ? bounce(p) : 1 - Math.pow(1 - p, k); var fm = thisComp.layer(\"Controls\").effect(\"Fade\")(\"Menu\"); var vin = fm == 3 || fm == 4 ? 0 : 100 * (1 - e); var vout = fm == 2 || fm == 3 ? 0 : 100 * Math.pow(q, k); var v = q > 0 ? vout : vin; [v, v, v]",
