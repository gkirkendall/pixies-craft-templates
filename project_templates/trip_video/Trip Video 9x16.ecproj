                      "match": "position",
                      "name": "Position",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          540.0,
                          960.0,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var P = thisComp.layer(\"Controls\").effect(\"Position\")(\"Point\"); var mw = thisComp.width * thisComp.layer(\"Controls\").effect(\"Max Width\")(\"Slider\") / 100; var tl = thisComp.layer(\"Text\"); var r = tl.sourceRectAtTime(time, false); var fs = tl.text.sourceText.style.fontSize; var hs = thisComp.layer(\"Controls\").effect(\"Heart Size\")(\"Slider\") / 100 * fs; var gap = 0.45 * fs; var full = r.width + 2 * (gap + hs); var f = full > mw ? mw / full : 1; var t0 = thisComp.layer(\"Controls\").effect(\"Start\")(\"Slider\"); var d = thisComp.layer(\"Controls\").effect(\"Duration\")(\"Slider\"); var a = Math.min(Math.max((time - t0) / 0.6, 0), 1); a = 1 - Math.pow(1 - a, 2); var z = Math.min(Math.max((d - time) / 0.5, 0), 1); z = 1 - Math.pow(1 - z, 2); [P[0], P[1] - (r.top + r.height / 2) * f + 24 * (1 - a), 0]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
                    },
