                      "expr": {
                        "text": "var W = 1080, H = 1920; var c = thisComp.layer(\"Controls\"); var inset = c.effect(\"Corner Inset\")(\"Checkbox\") == 1; var k = inset ? 0.5 : 1; var s = inset ? 0.7 : 1; var o = inset ? [W - 48 - W * k, 48] : [0, 0]; function P(p) { return [o[0] + p[0] * k, o[1] + p[1] * k]; } [o[0] + W * k - 14 * s, o[1] + H * k - 14 * s]",
