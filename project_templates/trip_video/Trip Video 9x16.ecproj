                        "text": "var t0 = thisComp.layer(\"Controls\").effect(\"Start\")(\"Slider\"); var d = thisComp.layer(\"Controls\").effect(\"Duration\")(\"Slider\"); var a = Math.min(Math.max((time - t0) / 0.6, 0), 1); a = 1 - Math.pow(1 - a, 2); var z = Math.min(Math.max((d - time) / 0.5, 0), 1); z = 1 - Math.pow(1 - z, 2); var on = 1; if (thisComp.layer(\"Controls\").effect(\"Blink\")(\"Checkbox\") == 1 && time >= t0 + 0.7) { var ph = ((time - t0 - 0.7) * thisComp.layer(\"Controls\").effect(\"Beats per Minute\")(\"Slider\") / 60) % 1; on = ph < 0.6 ? 1 : 0; } 100 * z * on",
