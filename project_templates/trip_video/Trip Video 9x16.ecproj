                              "in_tangents": [],
                              "out_tangents": [],
                              "closed": false
                            }
                          },
                          "expr": {
                            "text": "var W = 1080, H = 1920; var c = thisComp.layer(\"Controls\"); var inset = c.effect(\"Corner Inset\")(\"Checkbox\") == 1; var k = inset ? 0.5 : 1; var s = inset ? 0.7 : 1; var o = inset ? [W - 48 - W * k, 48] : [0, 0]; function P(p) { return [o[0] + p[0] * k, o[1] + p[1] * k]; } var a = P(c.effect(\"From Position\")(\"Point\")); var b = P(c.effect(\"To Position\")(\"Point\")); var d = [b[0] - a[0], b[1] - a[1]]; var cv = (c.effect(\"Curve\")(\"Slider\") - 50) / 100; var q = [(a[0] + b[0]) / 2 + d[1] * cv, (a[1] + b[1]) / 2 - d[0] * cv]; createPath([a, b], [[0, 0], [(q[0] - b[0]) * 2 / 3, (q[1] - b[1]) * 2 / 3]], [[(q[0] - a[0]) * 2 / 3, (q[1] - a[1]) * 2 / 3], [0, 0]], false)",
                            "enabled": true
                          },
                          "ui": {
                            "kind": "Path"
                          },
                          "spatial": false,
                          "hold_only": false,
                          "three_d_only": false,
                          "two_d_only": false,
                          "shown_dims": 0,
                          "static_only": false
                        }
