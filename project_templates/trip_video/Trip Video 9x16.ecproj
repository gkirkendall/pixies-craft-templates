                      "expr": {
                        "text": "var W = 1080, H = 1920; var c = thisComp.layer(\"Controls\"); var inset = c.effect(\"Corner Inset\")(\"Checkbox\") == 1; var k = inset ? 0.5 : 1; var s = inset ? 0.7 : 1; var o = inset ? [W - 48 - W * k, 48] : [0, 0]; function P(p) { return [o[0] + p[0] * k, o[1] + p[1] * k]; } var p = P(c.effect(\"To Position\")(\"Point\")); var q = P(c.effect(\"From Position\")(\"Point\")); var r = sourceRectAtTime(time, false); var f = Math.min(s, (W * k - 32 * s) / Math.max(r.width, 1)); var above = p[1] - 30 * s, below = p[1] + 34 * s - r.top * f; var y = q[1] < p[1] ? below : above; if (y == below && y + (r.top + r.height) * f > o[1] + H * k - 12 * s) y = above; if (y == above && y + r.top * f < o[1] + 12 * s) y = below; var hw = r.width / 2 * f; var x = Math.min(Math.max(p[0], o[0] + 16 * s + hw), o[0] + W * k - 16 * s - hw); [x - (r.left + r.width / 2) * f, y]",
