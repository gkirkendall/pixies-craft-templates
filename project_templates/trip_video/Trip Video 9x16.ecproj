                                        "text": "var w = String(thisComp.layer(\"Raw\").text.sourceText).split(/\\s+/); var on = false, hit = 0; for (var j = 0; j < w.length && j < textIndex; j++) { if (w[j].charAt(0) == \"*\") on = true; hit = on ? 100 : 0; if (w[j].length > 1 && w[j].charAt(w[j].length - 1) == \"*\") on = false; else if (w[j] == \"*\" && j > 0) on = false; } [hit, hit, hit]",
