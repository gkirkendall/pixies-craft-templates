                      },
                      "expr": {
                        "text": "var P = thisComp.layer(\"Controls\").effect(\"Position\")(\"Point\"); var mw = thisComp.width * thisComp.layer(\"Controls\").effect(\"Max Width\")(\"Slider\") / 100; var tl = thisComp.layer(\"Text\"); var r = tl.sourceRectAtTime(time, false); var fs = tl.text.sourceText.style.fontSize; var hs = thisComp.layer(\"Controls\").effect(\"Heart Size\")(\"Slider\") / 100 * fs; var gap = 0.45 * fs; var full = r.width + 2 * (gap + hs); var f = full > mw ? mw / full : 1; var t0 = thisComp.layer(\"Controls\").effect(\"Start\")(\"Slider\"); var d = thisComp.layer(\"Controls\").effect(\"Duration\")(\"Slider\"); var a = Math.min(Math.max((time - t0) / 0.6, 0), 1); a = 1 - Math.pow(1 - a, 2); var z = Math.min(Math.max((d - time) / 0.5, 0), 1); z = 1 - Math.pow(1 - z, 2); [P[0] + 1 * (r.width / 2 + gap + hs / 2) * f, P[1] + 24 * (1 - a), 0]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
