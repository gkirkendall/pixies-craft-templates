                        "text": "var W = 1080, H = 1920; var c = thisComp.layer(\"Controls\"); var inset = c.effect(\"Corner Inset\")(\"Checkbox\") == 1; var k = inset ? 0.5 : 1; var s = inset ? 0.7 : 1; var o = inset ? [W - 48 - W * k, 48] : [0, 0]; var m = thisComp.layer(\"Map\"); var mw = m.width, mh = m.height; var pl = c.effect(\"Place Position\")(\"Point\"); var e = ease(time, 0.6, 2.4, 0, 1); var s0 = Math.max(W / mw, H / mh); var z = s0 * Math.pow(Math.max(c.effect(\"Zoom\")(\"Slider\"), 1), e); var pos = [pl[0] * s0 + (W / 2 - pl[0] * s0) * e, pl[1] * s0 + (H / 2 - pl[1] * s0) * e]; pos = [Math.min(Math.max(pos[0], W - (mw - pl[0]) * z), pl[0] * z), Math.min(Math.max(pos[1], H - (mh - pl[1]) * z), pl[1] * z)]; function C(p) { return [o[0] + p[0] * k, o[1] + p[1] * k]; } var pin = C(pos); var nb = pin[1] + 74 * s, sb = nb + 48 * s; if (sb + 14 * s > o[1] + H * k - 16 * s) { sb = pin[1] - 30 * s; nb = sb - 46 * s; } var r = sourceRectAtTime(time, false); var f = Math.min(s, (W * k - 32 * s) / Math.max(r.width, 1)); var hw = r.width / 2 * f; var x = Math.min(Math.max(pin[0], o[0] + 16 * s + hw), o[0] + W * k - 16 * s - hw) - (r.left + r.width / 2) * f; [x, nb]",
