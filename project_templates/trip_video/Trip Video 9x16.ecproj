                          100.0
                        ]
                      },
                      "expr": {
                        "text": "var P = thisComp.layer(\"Controls\").effect(\"Position\")(\"Point\"); var mw = thisComp.width * thisComp.layer(\"Controls\").effect(\"Max Width\")(\"Slider\") / 100; var tl = thisComp.layer(\"Text\"); var r = tl.sourceRectAtTime(time, false); var fs = tl.text.sourceText.style.fontSize; var hs = thisComp.layer(\"Controls\").effect(\"Heart Size\")(\"Slider\") / 100 * fs; var gap = 0.45 * fs; var full = r.width + 2 * (gap + hs); var f = full > mw ? mw / full : 1; var t0 = thisComp.layer(\"Controls\").effect(\"Start\")(\"Slider\"); var d = thisComp.layer(\"Controls\").effect(\"Duration\")(\"Slider\"); var a = Math.min(Math.max((time - t0) / 0.6, 0), 1); a = 1 - Math.pow(1 - a, 2); var z = Math.min(Math.max((d - time) / 0.5, 0), 1); z = 1 - Math.pow(1 - z, 2); var u = Math.min(Math.max((time - t0 - 0.25) / 0.45, 0), 1); var c = 1.7; var k = u <= 0 ? 0 : 1 + (c + 1) * Math.pow(u - 1, 3) + c * Math.pow(u - 1, 2); var s = hs / 100 * f * k * 100; [s, s, 100]",
