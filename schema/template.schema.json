{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gkirkendall/pixies-craft-templates/schema/template.schema.json",
  "title": "craft-templates template manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "app",
    "app_min_version",
    "built_with",
    "tested",
    "kind",
    "category",
    "description",
    "variants",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(effectcraft|figcraft|vectorcraft|filmcraft)/[a-z0-9_]+/[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "app": {
      "type": "string",
      "enum": [
        "effectcraft",
        "figcraft",
        "vectorcraft",
        "filmcraft"
      ]
    },
    "app_min_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "built_with": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "frozen": {
      "type": "boolean"
    },
    "tested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "result",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "checks": {
            "type": "string",
            "pattern": "^[0-9]+/[0-9]+$"
          }
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "motion",
        "still",
        "chart",
        "logo",
        "transition"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "size",
          "file",
          "output"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "file": {
            "type": "string",
            "pattern": "^templates/"
          },
          "output": {
            "type": "string",
            "enum": [
              "h264",
              "prores4444",
              "png",
              "svg",
              "pdf"
            ]
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "color",
              "point",
              "checkbox",
              "dropdown",
              "media",
              "font",
              "data"
            ]
          },
          "default": {},
          "description": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "dropdown only: its items in order; values files and default name one of them"
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fill": {
      "type": "string"
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
